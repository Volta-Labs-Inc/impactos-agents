#!/bin/sh
# impactOS deterministic CLI (POSIX launcher). No install step: it runs the
# vendored package directly with the system Python 3.9+.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PY="${IMPACTOS_PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || PY=python
exec "$PY" "$DIR/cli/run.py" "$@"
