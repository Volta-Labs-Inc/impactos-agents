.env
.env.*
node_modules/
__pycache__/
# The workspace tree holds source exports, records, reports, provenance and
# personal data. Ignore it wholesale; commit only the .gitkeep placeholder.
workspace/*
!workspace/.gitkeep
# Top-level generated output only (anchored): committed golden reports under
# fixtures/ and the tracked contract exports must not be swallowed.
/exports/
/reports/
# The versioned contract export mappings are tracked (distinct from generated exports/)
!contract/exports/
!contract/exports/**

# Local config (private)
.mcp.json
time-tracker.json

# OS files
.DS_Store
Thumbs.db

# Caches
.cache/
*.pyc

# Large binaries
*.zip
*.tar.gz
*.dmg

# Context map lives in the OutworkOS database; local copy is private
context-map.md
next-steps.md
log.md
