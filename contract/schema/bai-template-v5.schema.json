{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bai-template-v5.schema.json",
  "title": "BAI template v5 export mapping",
  "type": "object",
  "required": ["contract_version", "target", "sheets", "vocabularies", "excel_validations"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_from": { "type": "string" },
    "notes": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["template_version", "schema_major"],
      "additionalProperties": false,
      "properties": {
        "template_version": { "type": "string" },
        "schema_major": { "type": "integer" },
        "workbook": { "type": "string" }
      }
    },
    "sheets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["grain", "columns"],
        "additionalProperties": false,
        "properties": {
          "grain": { "type": "string" },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["column", "source"],
              "additionalProperties": false,
              "properties": {
                "column": { "type": "string" },
                "source": { "type": "string" },
                "transformation": { "type": "string" },
                "vocabulary": { "type": "string" },
                "unmapped": { "type": "boolean" },
                "reason": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "vocabularies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "excel_validations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sheet", "field", "range", "vocabulary"],
        "additionalProperties": false,
        "properties": {
          "sheet": { "type": "string" },
          "field": { "type": "string" },
          "range": { "type": "string" },
          "vocabulary": { "type": "string" }
        }
      }
    }
  }
}
