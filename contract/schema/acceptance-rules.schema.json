{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-rules.schema.json",
  "title": "Founder-submission acceptance rules",
  "type": "object",
  "required": ["contract_version", "routes", "default_policy_by_class"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_from": { "type": "string" },
    "notes": { "type": "string" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["auto_accept", "review", "reject"] }
    },
    "default_policy_by_class": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["route", "rationale"],
        "additionalProperties": false,
        "properties": {
          "route": { "type": "string", "enum": ["auto_accept", "review", "reject"] },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
