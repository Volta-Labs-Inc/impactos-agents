{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reporting-profile.schema.json",
  "title": "Direct-beneficiary reporting profile",
  "type": "object",
  "required": ["contract_version", "profile_name", "anchors", "fields"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile_name": { "type": "string" },
    "generated_from": { "type": "string" },
    "notes": { "type": "string" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "anchor", "contract_path"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string" },
          "anchor": { "type": "string" },
          "contract_path": { "type": "string" },
          "derivation": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
